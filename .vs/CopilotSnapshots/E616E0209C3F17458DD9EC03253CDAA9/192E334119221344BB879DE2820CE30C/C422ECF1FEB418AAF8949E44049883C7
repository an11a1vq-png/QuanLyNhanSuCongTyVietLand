using System;
using Supabase.Postgrest.Models;
using Postgrest.Attributes;

namespace testai.DTOs
{
    /// <summary>
    /// DTO mapping với bảng Departments trên Supabase
    /// Đại diện cho các phòng ban trong công ty
    /// </summary>
    [Serializable]
    public class DepartmentDTO : BaseModel
    {
        [Postgrest.Attributes.Column("department_id")]
        public int DepartmentId { get; set; }

        [Postgrest.Attributes.Column("department_name")]
        public string DepartmentName { get; set; }

        [Postgrest.Attributes.Column("manager_id")]
        public int ManagerId { get; set; }

        [Postgrest.Attributes.Column("created_at")]
        public DateTime CreatedAt { get; set; }
    }
}
