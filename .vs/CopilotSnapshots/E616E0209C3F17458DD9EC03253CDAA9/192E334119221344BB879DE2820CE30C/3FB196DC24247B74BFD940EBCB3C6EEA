using System;
using Supabase.Postgrest.Models;

namespace testai.DTOs
{
    /// <summary>
    /// DTO mapping với bảng EmailLogs trên Supabase
    /// Đại diện cho lịch sử gửi email của hệ thống
    /// </summary>
    [Serializable]
    public class EmailLogDTO : BaseModel
    {
        [Postgrest.Attributes.Column("email_log_id")]
        public int EmailLogId { get; set; }

        [Postgrest.Attributes.Column("subject")]
        public string Subject { get; set; }

        [Postgrest.Attributes.Column("content")]
        public string Content { get; set; }

        [Postgrest.Attributes.Column("receiver")]
        public string Receiver { get; set; }

        [Postgrest.Attributes.Column("sent_at")]
        public DateTime SentAt { get; set; }

        [Postgrest.Attributes.Column("status")]
        public string Status { get; set; } // Success, Failed
    }
}
